---
const path = Astro.url.pathname;
const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/notes/', label: 'Notes' },
  { href: '/#about', label: 'About' },
];
---

<header class="site-header">
  <div class="shell nav-wrap">
    <a class="brand" href="/" aria-label="Skyler Bradley home">
      <span class="brand-mark" aria-hidden="true">SB</span>
      <span>Skyler Bradley</span>
    </a>
    <nav aria-label="Primary navigation">
      {nav.map((item) => (
        <a href={item.href} aria-current={path.startsWith(item.href) && item.href !== '/#work' ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <a class="nav-cta" href="https://github.com/Madsky39" rel="me noreferrer">GitHub</a>
    </nav>
  </div>
</header>
