---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
---

<BaseLayout
  title="Skyler Bradley | Security-minded systems and data"
  description="IT and security professional building reliable, data-driven systems. Selected engineering work, technical case studies, and notes."
>
  <section class="hero" id="top">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="kicker"><span></span> Sacramento, California</p>
        <h1>Security-minded systems.<br /><em>Data-backed decisions.</em></h1>
        <p class="hero-lede">
          I’m an IT and security professional building reliable tools at the intersection of systems engineering,
          security operations, and data science.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#work">Explore my work</a>
          <a class="button secondary" href="https://github.com/Madsky39" rel="me noreferrer">View GitHub</a>
          <a class="button secondary" href="https://www.linkedin.com/in/skylerbradley" rel="me noreferrer">LinkedIn</a>
        </div>
      </div>
      <aside class="signal-card" aria-label="Current focus">
        <p class="eyebrow">Current signal</p>
        <p class="signal-title">Building systems that can explain themselves.</p>
        <div class="signal-lines">
          <span><b>01</b> Deterministic engineering</span>
          <span><b>02</b> Secure infrastructure</span>
          <span><b>03</b> Applied data science</span>
        </div>
      </aside>
    </div>
  </section>

  <section class="section" id="work">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2>Built beyond the tutorial.</h2>
        </div>
        <p>Case studies focused on constraints, design decisions, evidence, and the tradeoffs behind the result.</p>
      </div>
      <div class="project-grid">
        <ProjectCard
          href="/projects/secure-homelab/"
          eyebrow="Infrastructure · Security"
          title="A small homelab with a real threat model"
          description="A defense-in-depth architecture built around private networking, least privilege, service isolation, recoverable backups, and evidence-based hardening."
          tags={['Linux', 'Tailscale', 'nftables', 'Restic']}
        />
        <ProjectCard
          href="/projects/lean-pantry/"
          eyebrow="Product engineering"
          title="Lean Pantry"
          description="A practical meal-planning application that turns a curated recipe dataset into editable weekly plans, scaled ingredients, and grocery lists."
          tags={['Python', 'Streamlit', 'SQLite', 'Product design']}
        />
      </div>
    </div>
  </section>

  <section class="section about" id="about">
    <div class="shell about-grid">
      <div>
        <p class="eyebrow">About</p>
        <h2>I care about systems that hold up under scrutiny.</h2>
      </div>
      <div class="about-copy">
        <p>
          My background spans IT operations and security, with formal study now extending into data science. The common
          thread is disciplined problem-solving: define the real constraint, make state observable, test assumptions,
          and document the limits of the result.
        </p>
        <p>
          I hold a B.S. in Information Technology and industry certifications including CySA+, Security+, Network+,
          AWS Cloud Practitioner, Project+, and ITIL 4 Foundation. I’m currently completing an M.S. in Data Analytics,
          Data Science specialization.
        </p>
        <div class="principles">
          <div><span>01</span><strong>Evidence over theater</strong></div>
          <div><span>02</span><strong>Secure by design</strong></div>
          <div><span>03</span><strong>Useful beats clever</strong></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section notes-preview">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Field notes</p>
          <h2>What I learned while building.</h2>
        </div>
        <a class="text-link" href="/notes/">All notes <span>→</span></a>
      </div>
      <a class="note-row" href="/notes/a-backup-is-not-trusted-until-restore/">
        <div>
          <p class="note-meta"><time datetime="2026-08-04">August 4, 2026</time> · 6 min read</p>
          <h3>A backup is not trusted until restoration succeeds</h3>
          <p>Why successful jobs and healthy repositories are evidence of storage, not recoverability.</p>
        </div>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <section class="contact-strip">
    <div class="shell contact-wrap">
      <div>
        <p class="eyebrow">Connect</p>
        <h2>Interested in the work?</h2>
        <p class="contact-email">skylerbradley1@gmail.com</p>
      </div>
      <div class="contact-actions">
        <a class="button primary" href="mailto:skylerbradley1@gmail.com">Send an email</a>
        <a class="button secondary" href="https://www.linkedin.com/in/skylerbradley" rel="me noreferrer">LinkedIn</a>
      </div>
    </div>
  </section>
</BaseLayout>
